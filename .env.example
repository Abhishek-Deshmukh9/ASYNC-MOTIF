# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=motif
POSTGRES_USER=motif_user
POSTGRES_PASSWORD=motif_password

# Database URLs (localhost for local dev, postgres:5432 inside docker)
DATABASE_URL=postgresql+asyncpg://motif_user:motif_password@localhost:5432/motif
SYNC_DATABASE_URL=postgresql://motif_user:motif_password@localhost:5432/motif

# --- Using Supabase instead of local Postgres? Replace the two URLs above with: ---
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres   (Transaction pooler)
# SYNC_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres      (Session pooler, used for migrations)
# Copy both from Supabase > Connect > Connection String. Use the pooler URLs (IPv4), not "Direct connection".

# Supabase keys (Project Settings > API Keys). The secret key is server-side only: never commit it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Sign-in is required on the API whenever SUPABASE_URL is set. Set AUTH_REQUIRED=false to switch it off locally.
# AUTH_REQUIRED=
# Only for older Supabase projects that sign tokens with a shared secret (Project Settings > JWT Keys > Legacy JWT Secret).
# SUPABASE_JWT_SECRET=
# The frontend needs the browser-safe values too: copy the two lines below into triage-ui/.env.local
#   NEXT_PUBLIC_SUPABASE_URL=<same as SUPABASE_URL>
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<same as SUPABASE_PUBLISHABLE_KEY>

# LLM Configuration (100% Free tier: Groq or Google Gemini Flash)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub Dispatcher Configuration (Phase 5)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_V1_PREFIX=/api/v1
PROJECT_NAME=Motif
